{
  "schemaVersion": 1,
  "id": "opencode",
  "version": "rust-1",
  "statusModel": "full",
  "agent": {
    "id": "opencode",
    "displayName": "OpenCode",
    "shortLabel": "OpenCode",
    "glyph": "terminal",
    "aliases": ["opencode"],
    "firstClass": false,
    "statusAuthority": "screen",
    "binary": "opencode",
    "envScrubPrefixes": ["OPENCODE_", "DIRI_", "DIRIJOR_"],
    "approve": { "text": "", "submit": true },
    "deny": { "text": "\u001b", "submit": false }
  },
  "rules": [
    {
      "id": "tool-confirmation",
      "state": "blockedPermission",
      "priority": 900,
      "region": "bottom_non_empty_lines",
      "regionLines": 12,
      "when": {
        "any": [
          { "contains": "Allow this action" },
          { "lineRegex": "(?i)(approve|permission).*(yes|allow|deny)" }
        ]
      }
    },
    {
      "id": "interrupt-hint-working",
      "state": "working",
      "priority": 500,
      "region": "bottom_non_empty_lines",
      "regionLines": 5,
      "when": { "contains": "esc to interrupt" }
    },
    {
      "id": "composer-idle",
      "state": "idle",
      "priority": 100,
      "region": "bottom_non_empty_lines",
      "regionLines": 5,
      "when": { "any": [{ "contains": "Ask anything" }, { "contains": "Type a message" }] }
    }
  ]
}

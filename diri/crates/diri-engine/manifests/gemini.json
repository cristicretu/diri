{
  "schemaVersion": 2,
  "id": "gemini",
  "version": "2026.07.10",
  "statusModel": "full",
  "agent": {
    "id": "gemini",
    "displayName": "Gemini",
    "shortLabel": "gemini",
    "glyph": "\u2726",
    "aliases": [
      "gemini",
      "gemini-cli"
    ],
    "firstClass": true,
    "catalogOrder": 50,
    "setup": {
      "url": "https://github.com/google-gemini/gemini-cli",
      "installHint": "Follow Google's Gemini CLI installation guide.",
      "signInHint": "Run gemini and choose an available Google or API-key authentication method."
    },
    "statusAuthority": "screen",
    "binary": "gemini",
    "sessionIDFlag": "--session-id",
    "resume": {
      "style": "flag",
      "token": "--resume"
    },
    "envScrubPrefixes": [
      "GEMINI_CLI",
      "DIRI_",
      "DIRIJOR_"
    ],
    "foregroundExecNames": [
      "gemini"
    ],
    "approve": {
      "text": "",
      "submit": true
    },
    "deny": {
      "text": "\u001b",
      "submit": false
    }
  },
  "rules": [
    {
      "id": "confirm-dialog",
      "state": "blockedPermission",
      "priority": 1000,
      "region": "whole_recent",
      "when": {
        "any": [
          {
            "contains": "apply this change?"
          },
          {
            "contains": "allow execution of"
          },
          {
            "contains": "do you want to proceed?"
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "waiting-for-confirmation",
      "state": "blockedQuestion",
      "priority": 950,
      "region": "whole_recent",
      "when": {
        "contains": "waiting for user confirmation"
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "working-cancel-timer",
      "state": "working",
      "priority": 900,
      "region": "bottom_non_empty_lines",
      "regionLines": 6,
      "when": {
        "contains": "esc to cancel"
      }
    },
    {
      "id": "idle-prompt-box",
      "state": "idle",
      "priority": 500,
      "region": "prompt_box_body",
      "when": {
        "lineRegex": "^\\s*>"
      }
    },
    {
      "id": "idle-placeholder",
      "state": "idle",
      "priority": 450,
      "region": "whole_recent",
      "when": {
        "contains": "type your message or @path/to/file"
      }
    }
  ]
}

{
  "schemaVersion": 2,
  "id": "gemini",
  "version": "2026.10.05.1",
  "statusModel": "full",
  "agent": {
    "id": "gemini",
    "displayName": "Gemini",
    "shortLabel": "gemini",
    "glyph": "\u2726",
    "aliases": [
      "gemini",
      "gemini-cli"
    ],
    "firstClass": true,
    "catalogOrder": 50,
    "setup": {
      "url": "https://github.com/google-gemini/gemini-cli",
      "installHint": "Follow Google's Gemini CLI installation guide.",
      "signInHint": "Run gemini and choose an available Google or API-key authentication method.",
      "installCommand": "npm install -g @google/gemini-cli",
      "installRequirement": "Node.js"
    },
    "statusAuthority": "screen",
    "binary": "gemini",
    "profile": {"environment": {"GEMINI_CLI_HOME": "{home}"}, "unsetEnvironment": ["GEMINI_API_KEY", "GOOGLE_API_KEY", "GOOGLE_APPLICATION_CREDENTIALS", "GOOGLE_GENAI_USE_VERTEXAI"]},
    "sessionIDFlag": "--session-id",
    "resume": {
      "style": "flag",
      "token": "--resume"
    },
    "conversation": {
      "freshArgs": ["--session-id", "{newId}"],
      "resume": {
        "exactArgs": ["--resume", "{id}"],
        "latestArgs": ["--resume", "latest"]
      },
      "stripArgs": [
        {"token": "--resume", "value": "any"},
        {"token": "--session-id", "value": "any"}
      ]
    },
    "returnToLoginShell": true,
    "envScrubPrefixes": [
      "GEMINI_CLI",
      "DIRI_",
      "DIRIJOR_"
    ],
    "foregroundExecNames": [
      "gemini"
    ],
    "approve": {
      "text": "",
      "submit": true
    },
    "deny": {
      "text": "\u001b",
      "submit": false
    }
  },
  "rules": [
    {
      "id": "confirm-dialog",
      "state": "blockedPermission",
      "priority": 1000,
      "region": "whole_recent",
      "when": {
        "any": [
          {
            "contains": "apply this change?"
          },
          {
            "contains": "allow execution of"
          },
          {
            "contains": "do you want to proceed?"
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "waiting-for-confirmation",
      "state": "blockedQuestion",
      "priority": 950,
      "region": "whole_recent",
      "when": {
        "contains": "waiting for user confirmation"
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "folder-trust-dialog",
      "state": "blockedQuestion",
      "priority": 960,
      "region": "bottom_non_empty_lines",
      "regionLines": 8,
      "when": {
        "all": [
          {
            "contains": "trust folder"
          },
          {
            "contains": "don't trust"
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "auth-dialog",
      "state": "blockedQuestion",
      "priority": 970,
      "region": "bottom_non_empty_lines",
      "regionLines": 20,
      "when": {
        "any": [
          {
            "contains": "how would you like to authenticate"
          },
          {
            "contains": "opening authentication page in your browser"
          },
          {
            "contains": "waiting for authentication"
          }
        ]
      },
      "flags": [
        "visible_blocker"
      ],
      "capture": {
        "region": "bottom_non_empty_lines",
        "regionLines": 12,
        "maxChars": 400
      }
    },
    {
      "id": "working-cancel-timer",
      "state": "working",
      "priority": 900,
      "region": "bottom_non_empty_lines",
      "regionLines": 12,
      "when": {
        "contains": "esc to cancel"
      }
    },
    {
      "id": "idle-prompt-box",
      "state": "idle",
      "priority": 500,
      "region": "prompt_box_body",
      "when": {
        "lineRegex": "^\\s*>"
      }
    },
    {
      "id": "idle-placeholder",
      "state": "idle",
      "priority": 450,
      "region": "whole_recent",
      "when": {
        "contains": "type your message or @path/to/file"
      }
    }
  ]
}
